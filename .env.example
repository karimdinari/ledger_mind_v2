# Copy to `.env` at the repo root, then:
#   docker compose up --build
#
# Only Docker Desktop (or Docker Engine + Compose) is required locally.

# Required for intake / guidance LLM
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Required for referral, capture, education (RAG)
MISTRAL_API_KEY=your_mistral_api_key_here

# Auth
AUTH_SECRET=ledgermind-dev-secret-change-me-32b
AUTH_TOKEN_DAYS=14

# Optional overrides (compose already sets mongo + CORS for containers)
MONGO_DB_NAME=ledgermind
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_BASE=http://localhost:8000

# Optional Légifrance MCP
# PISTE_CLIENT_ID=
# PISTE_CLIENT_SECRET=
