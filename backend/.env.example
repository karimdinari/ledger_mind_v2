# Gemini (Intake agent — questions + answer understanding)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Mistral (referral + capture + guidance RAG pedagogue)
# Get a key at: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here

# Pedagogue RAG (education page) — embeddings via Mistral (default) or local
# PEDAGOGUE_EMBEDDINGS_PROVIDER=mistral
# PEDAGOGUE_CHROMA_DIR=./app/agents/pedagogue/data/chroma

# Légifrance MCP (optional)
# PISTE_CLIENT_ID=
# PISTE_CLIENT_SECRET=

# MongoDB (users + orchestrator sessions + agent context)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ledgermind

# Auth JWT — change in production (min 32 characters)
AUTH_SECRET=ledgermind-dev-secret-change-me-32b
AUTH_TOKEN_DAYS=14

# Veille (optional cron; POST /api/education/veille/run always works)
# VEILLE_ENABLED=false
# VEILLE_CRON_HOUR=3

# CORS — frontend URL(s), comma-separated. Localhost any port is also allowed in code.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8082
